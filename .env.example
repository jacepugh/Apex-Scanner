# ══════════════════════════════════════════════════════════
# APEX SCANNER — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── DATA SOURCE ────────────────────────────────────────────
# Options: demo | polygon | finnhub | alphaVantage
DATA_SOURCE=demo

# ── API KEYS ───────────────────────────────────────────────
# Polygon.io (recommended) — https://polygon.io
# Free tier: 5 req/min (limited). Starter $29/mo = unlimited.
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub — https://finnhub.io
# Free tier: 60 req/min (good for testing)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage — https://www.alphavantage.co
# Free tier: 5 req/min, 500 req/day (very limited for scanning)
ALPHA_VANTAGE_API_KEY=your_av_api_key_here

# News API (optional supplement) — https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# ── DEFAULT SCAN FILTERS ───────────────────────────────────
PRICE_MIN=0.50
PRICE_MAX=25.00
VOL_MIN=1000000
RVOL_MIN=3.0
GAP_MIN=5.0
FLOAT_MAX=100000000

# ── REDIS (optional, for speed) ────────────────────────────
# Leave blank to use in-memory cache
# REDIS_URL=redis://localhost:6379

# ── TWILIO SMS ALERTS (optional) ───────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+1234567890
# ALERT_PHONE=+1234567890

# ── DATABASE (optional, for alert history persistence) ──────
# DATABASE_URL=postgresql://user:pa
